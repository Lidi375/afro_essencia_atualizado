# .env.example — AFRO ESSÊNCIA
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o .env — ele está no .gitignore.

# ── Ambiente ──────────────────────────────────────────────────
APP_ENV=production          # development | production
APP_BASE=                   # '' para raiz, '/afro_essencia' para subpasta

# ── Banco de dados ────────────────────────────────────────────
DB_HOST=localhost
DB_NAME=afro_essencia
DB_USER=root
DB_PASS=

# ── E-mail (Gmail com senha de app) ───────────────────────────
MAIL_USERNAME=seuemail@gmail.com
MAIL_PASSWORD=sua-senha-de-app-16-chars

# ── MercadoPago ───────────────────────────────────────────────
MP_ACCESS_TOKEN=APP_USR-seu-token-de-producao
MP_WEBHOOK_SECRET=sua-chave-secreta-webhook
